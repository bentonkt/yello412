{
  "name": "yello412-site",
  "version": "1.0.0",
  "private": true,
  "description": "Yello 412: marketing site plus the demo line's backend (Cloudflare Worker) and Retell agent.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && node scripts/preview.mjs",
    "dev": "node scripts/build.mjs && wrangler dev",
    "deploy": "node scripts/build.mjs --prod && wrangler deploy",
    "agent": "node scripts/agent.mjs",
    "test": "node --test worker/worker.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}
